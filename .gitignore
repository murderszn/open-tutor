# Ignore everything at repo root by default
/*

# Keep these root files/folders tracked
!.gitignore
!README.md
!AGENTS.md
!LICENSE
!SECURITY.md
!CONTRIBUTING.md
!firebase.json
!.firebaserc
!.github/
!.github/**

# Keep primary content folders tracked
!assignments/
!resources/
# Track the anonymous workspace starter only. Never commit real learner folders.
!students/
/students/*
!students/student-template/
!students/student-template/**

!teachers/
!site/
!frontend/
!frontend/**
frontend/node_modules/
frontend/dist/
frontend/.vite/
!curriculum/
!docs/
!scripts/

# Common OS/editor junk (ignored even inside whitelisted folders)
**/.DS_Store
**/Thumbs.db
**/*.log
**/~$*
__pycache__/
*.py[cod]
# Secrets and local credentials
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json
